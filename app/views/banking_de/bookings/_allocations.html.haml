%h2= t('.title')
%table.table.table-sm
  %thead
    %tr
      %th= t('banking_de.bookings.allocation_form.person')
      %th= t('banking_de.bookings.allocation_form.purpose')
      %th= t('banking_de.bookings.allocation_form.year')
      %th.text-end= t('banking_de.bookings.allocation_form.amount')
  %tbody
    - booking.allocations.list.includes(:person).each do |allocation|
      %tr
        %td= link_to(allocation.person.to_s(:list), group_person_path(group, allocation.person))
        %td= allocation.purpose_definition&.label || allocation.purpose
        %td= allocation.year
        %td.text-end= banking_de_amount(allocation.amount)
- if booking.note.present?
  %p= booking.note
- if booking.processed_at
  %p.text-muted= t('.processed', person: booking.processed_by, time: l(booking.processed_at, format: :short))
= button_to(t('.revert'), revert_group_bank_booking_path(group, booking), class: 'btn btn-outline-danger', form: {data: {turbo_confirm: t('.revert_confirm')}})
